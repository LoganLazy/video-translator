# Independent video subtitle translator. Copy to .env on a fresh install.
# Existing local .env is preserved by upgrades. Never include real keys in ZIPs.
VT_API_BASE=https://api.deepseek.com
VT_API_KEY=
VT_API_MODEL=deepseek-chat
VT_BATCH_SIZE=20
VT_BATCH_CHARS=8000
VT_BATCH_DELAY=15
VT_API_TIMEOUT=60
# Optional: disable GitHub download proxy with an empty value.
VT_GH_PROXY=https://gh-proxy.com/
# Optional: use https://huggingface.co instead of the default HF mirror.
# HF_ENDPOINT=https://huggingface.co
