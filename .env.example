# 复制为 .env 并填入你的配置(不配置也能用, 会自动走本地离线翻译)

# OpenAI 兼容接口地址, 常见选择:
#   DeepSeek:  https://api.deepseek.com
#   Kimi:      https://api.moonshot.cn/v1
#   通义千问:   https://dashscope.aliyuncs.com/compatible-mode/v1
#   OpenAI:    https://api.openai.com/v1
#   本地ollama: http://localhost:11434/v1
VT_API_BASE=https://api.deepseek.com

# 你的 API Key (必填才能启用 api 引擎)
VT_API_KEY=

# 模型名
VT_API_MODEL=deepseek-chat

# 每次请求翻译的台词条数(越大越省请求次数)
VT_BATCH_SIZE=20
